# Copy to .env and fill in. Never commit the real .env.

# --- Application ---
ENVIRONMENT=production            # production | development | test
DEBUG=false                       # true logs every SQL statement
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://school-dashboard-pink.vercel.app,http://localhost:5173
FRONTEND_URL=https://school-dashboard-pink.vercel.app   # used in password-reset emails

# --- Database (Supabase) ---
# Supabase dashboard -> Connect -> Connection string.
# App (long-running server): use the Session pooler string (port 5432) or the Direct connection.
# The Transaction pooler (port 6543) also works; prepared statements are disabled automatically.
# postgres:// and postgresql:// are accepted and converted to the asyncpg driver; ?sslmode is handled.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Migrations / data import: Session pooler or Direct connection (NOT the 6543 transaction pooler).
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SSL=require                  # auto-enabled for *.supabase.co / *.supabase.com hosts
# Connections per worker process = DB_POOL_SIZE + DB_MAX_OVERFLOW. Keep
# (workers x that) below your plan's connection limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Local development instead of Supabase:
# DATABASE_URL=sqlite+aiosqlite:///school_management.db
# ENVIRONMENT=development         # creates tables + demo accounts automatically

# --- Email (fastapi-mail) ---
EMAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- Paystack ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=            # frontend page Paystack redirects to after checkout (used when the request doesn't send callback_url)

# --- Cloudinary (profile pictures) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- PDFs ---
PDF_LOGO_PATH=assets/images/school_logo.png
